# Demo mode works without any API key. Restart the server after changes.
# Add your own key here to enable Sora. Never put keys in VITE_* variables.
VIDEO_API_KEY=
PORT=3001
HOST=127.0.0.1
# Local AI services run on your own computer, without paid API credentials.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
COMFYUI_URL=http://127.0.0.1:8188
# Used only by npm run local:start, not required when services are started manually.
# COMFYUI_DIR=C:/AI/ComfyUI
# COMFYUI_PYTHON=C:/AI/ComfyUI/.venv/Scripts/python.exe
# Optional: absolute path if ffmpeg is not on PATH.
# FFMPEG_PATH=/usr/bin/ffmpeg
